{
  "manifest_version": 2,
  "name": "Tab Management Agent Bridge for Firefox",
  "version": "0.3.0",
  "description": "Connects a local MCP server to Firefox tab and tab-group APIs.",
  "permissions": ["tabs", "tabGroups", "storage", "*://127.0.0.1/*"],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-management-agent-bridge@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
